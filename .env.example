# Public backend URL for the Expo app (no secrets).
# Emulator / simulator defaults are auto-detected when unset.
#
# Physical device example (replace with your computer's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.42:4000
#
# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
#
# iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:4000

EXPO_PUBLIC_API_URL=http://localhost:4000
