# Local Ollama (default — no cloud key needed)
AI_API_KEY=ollama
AI_BASE_URL=http://127.0.0.1:11434/v1
# Vision model: moondream (small). llama3.2:3b is text-only.
AI_MODEL=moondream

# Cloud OpenRouter / OpenAI (optional)
# AI_API_KEY=sk-your-api-key-here
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-4o-mini

PORT=4000
CLIENT_ORIGIN=*
MAX_UPLOAD_BYTES=5242880
AI_TIMEOUT_MS=120000
