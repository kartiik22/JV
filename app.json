{
  "expo": {
    "name": "Sight AI",
    "slug": "sight-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "sight-ai",
    "newArchEnabled": false,
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Sight AI needs camera access to analyze your surroundings while scanning is active. Images are sent to your configured AI backend only when you start scanning.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Sight AI uses the camera to analyze surroundings while scanning is active. Capture is user-controlled and frames are not stored by default."
      },
      "bundleIdentifier": "com.sightai.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05080D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "package": "com.sightai.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
